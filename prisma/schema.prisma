// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Converted for MongoDB. Key differences from the Postgres version:
// - IDs use Mongo's native ObjectId (`@default(auto()) @map("_id") @db.ObjectId`)
//   instead of `cuid()`.
// - Foreign-key-style fields are typed `String @db.ObjectId`.
// - Property <-> Amenity is now a native many-to-many via relation scalar
//   lists on both sides — MongoDB doesn't need a separate join collection
//   the way Postgres did, so the old `PropertyAmenity` model is removed.
// - No `directUrl` — that was only needed for Postgres connection pooling.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------
// ENUMS
// ---------------------------------------------

enum Role {
  TENANT
  OWNER
  ADMIN
}

enum RoomType {
  PRIVATE
  SHARED
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PropertyReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum EmailDeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

// ---------------------------------------------
// MODELS
// ---------------------------------------------

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(TENANT)
  emailVerifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Notification preferences -- gate which emails this user receives
  emailOnBookingRequests     Boolean @default(true)
  emailOnRoommateMatches     Boolean @default(true)
  emailOnProductAnnouncements Boolean @default(true)

  // Relations
  tenantProfile   TenantProfile?
  ownerProfile    OwnerProfile?
  properties      Property[]       @relation("OwnerProperties")
  bookingRequests BookingRequest[] @relation("TenantBookings")
  roommateRequestsSent     RoommateConnection[] @relation("RoommateRequestsSent")
  roommateRequestsReceived RoommateConnection[] @relation("RoommateRequestsReceived")
  authTokens AuthToken[]

  @@map("users")
}

model TenantProfile {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @unique @db.ObjectId
  fullName          String
  occupation        String?
  avatarUrl         String?
  phone             String?
  bio               String?
  budgetMin         Int?
  budgetMax         Int?
  preferredLocation String?
  preferredLocationKey String @default("")
  // Flexible JSON blob for lifestyle matching e.g.
  // { smoking: false, pets: true, foodPreference: "veg", sleepSchedule: "early" }
  lifestyleParams   Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([preferredLocationKey, budgetMax, updatedAt])
  @@map("tenant_profiles")
}

model OwnerProfile {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @unique @db.ObjectId
  phone         String
  businessName  String
  // AES-256-GCM ciphertext written by lib/owner-id.ts.
  governmentId  String
  city          String
  address       String
  agreedToTerms Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("owner_profiles")
}

model Property {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  ownerId     String   @db.ObjectId
  title       String
  description String?
  address     String
  city        String
  citySearchKey String @default("")
  addressSearchKey String @default("")
  state       String
  isApproved  Boolean  @default(false)
  reviewStatus PropertyReviewStatus @default(PENDING)
  imageUrls   String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner User @relation("OwnerProperties", fields: [ownerId], references: [id], onDelete: Cascade)
  rooms Room[]

  // Native many-to-many with Amenity (no join collection needed on Mongo)
  amenityIds String[]  @db.ObjectId
  amenities  Amenity[] @relation(fields: [amenityIds], references: [id])

  @@index([city, state])
  @@index([isApproved, reviewStatus, city, state])
  @@index([citySearchKey, isApproved, reviewStatus])
  @@index([addressSearchKey, isApproved, reviewStatus])
  @@index([reviewStatus, isApproved, createdAt])
  @@index([ownerId, createdAt])
  @@map("properties")
}

model Room {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  propertyId       String   @db.ObjectId
  roomType         RoomType
  genderPreference String   @default("ANY")
  totalBeds        Int
  availableBeds    Int
  amenities        String[] @default([])
  rentPerMonth     Int
  depositAmount    Int
  availabilityDate DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  property        Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bookingRequests BookingRequest[]

  @@index([propertyId])
  @@index([availableBeds, rentPerMonth])
  @@index([availableBeds, createdAt])
  @@index([roomType, availableBeds, rentPerMonth])
  @@map("rooms")
}

model Amenity {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  icon      String?
  createdAt DateTime @default(now())

  propertyIds String[]   @db.ObjectId
  properties  Property[] @relation(fields: [propertyIds], references: [id])

  @@map("amenities")
}

model BookingRequest {
  id         String        @id @default(auto()) @map("_id") @db.ObjectId
  tenantId   String        @db.ObjectId
  roomId     String        @db.ObjectId
  status     BookingStatus @default(PENDING)
  moveInDate DateTime
  message    String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  tenant User @relation("TenantBookings", fields: [tenantId], references: [id], onDelete: Cascade)
  room   Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  // One application record per tenant and room prevents concurrent duplicate submissions.
  @@unique([tenantId, roomId])
  @@index([tenantId, createdAt])
  @@index([roomId, status, createdAt])
  @@map("booking_requests")
}

model RoommateConnection {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  requesterId String           @db.ObjectId
  targetId    String           @db.ObjectId
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester User @relation("RoommateRequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  target    User @relation("RoommateRequestsReceived", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([requesterId, targetId])
  @@index([targetId, status])
  @@map("roommate_connections")
}

model AuthToken {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  userId    String          @db.ObjectId
  tokenHash String          @unique
  purpose   AuthTokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@map("auth_tokens")
}

model EmailOutbox {
  id             String             @id @default(auto()) @map("_id") @db.ObjectId
  to             String
  subject        String
  encryptedHtml  String
  status         EmailDeliveryStatus @default(PENDING)
  attempts       Int                @default(0)
  nextAttemptAt  DateTime           @default(now())
  lockedAt       DateTime?
  lastError      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status, nextAttemptAt])
  @@index([status, lockedAt])
  @@map("email_outbox")
}
